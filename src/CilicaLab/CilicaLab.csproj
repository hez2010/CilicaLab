<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <WasmBuildNative>false</WasmBuildNative>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <ProjectReference Include="../CilicaLab.Compiler/CilicaLab.Compiler.csproj" />
    <StaticWebAssetFingerprintPattern Include="LabModule" Pattern="*.mjs" Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <Import Project="FrameworkAssets.targets" />
</Project>
