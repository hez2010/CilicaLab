@implements IAsyncDisposable

<PageTitle>Cilica Lab · Explore the optimizer</PageTitle>

<div class="lab-shell">
    <header class="app-header">
        <a class="brand" href="./" aria-label="Cilica Lab home">
            <svg class="brand-mark" width="28" height="30" viewBox="0 0 30 32" fill="none" aria-hidden="true">
                <defs>
                    <linearGradient id="brand-gradient" x1="2" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
                        <stop style="stop-color: var(--brand-from)" />
                        <stop offset="1" style="stop-color: var(--brand-to)" />
                    </linearGradient>
                </defs>
                <path d="M15 2 28 9.5v13L15 30 2 22.5v-13L15 2Z" stroke="url(#brand-gradient)" stroke-width="1.6" />
                <path d="m15 9 7 4v7l-7 4-7-4v-7l7-4Z" fill="url(#brand-gradient)" />
            </svg>
            <span>Cilica <span class="brand-light">Lab</span></span>
            <span class="version-badge">@($"v{CilicaVersion}")</span>
        </a>
        <span class="brand-tagline">Inspect every pass of the Cilica .NET optimizer</span>
        <div class="header-actions">
            <div class="theme-switch" role="radiogroup" aria-label="Color theme">
                <label title="Match system theme">
                    <input type="radio" name="theme" checked="@(_theme == "system")" @onchange="@(() => ChangeThemeAsync("system"))" />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8m-4-4v4" /></svg>
                    <span class="visually-hidden">System</span>
                </label>
                <label title="Light theme">
                    <input type="radio" name="theme" checked="@(_theme == "light")" @onchange="@(() => ChangeThemeAsync("light"))" />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2m0 15v2M4.6 4.6 6 6m12 12 1.4 1.4M2.5 12h2m15 0h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
                    <span class="visually-hidden">Light</span>
                </label>
                <label title="Dark theme">
                    <input type="radio" name="theme" checked="@(_theme == "dark")" @onchange="@(() => ChangeThemeAsync("dark"))" />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
                    <span class="visually-hidden">Dark</span>
                </label>
            </div>
            <a class="repository-link" href="https://github.com/hez2010/Cilica" target="_blank" rel="noopener noreferrer" title="Cilica on GitHub">
                <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
                <span>GitHub</span>
            </a>
        </div>
    </header>

    <main>
        <div class="toolbar">
            <div class="sample-picker">
                <label for="sample">Example</label>
                <select id="sample" value="@_sampleId" @onchange="ChangeSampleAsync" disabled="@_busy">
                    @if (_sampleId == "custom") { <option value="custom">Custom code</option> }
                    @foreach (var sample in Samples.All) { <option value="@sample.Id">@sample.Name</option> }
                </select>
            </div>
            <details class="settings">
                <summary class="button secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h9m4 0h3M4 17h3m4 0h9" /><circle cx="15" cy="7" r="2.2" /><circle cx="9" cy="17" r="2.2" /></svg>
                    Options
                    <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="settings-panel">
                    <p class="settings-title">C# compilation</p>
                    <label><span>Roslyn Release optimization</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.Release" @bind:set="(bool value) => OptionsChangedAsync(_options with { Release = value })" disabled="@_busy" /></label>
                    <p class="settings-title">Cilica optimization</p>
                    <label><span>Method inlining</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.EnableInlining" @bind:set="(bool value) => OptionsChangedAsync(_options with { EnableInlining = value })" disabled="@_busy" /></label>
                    <label><span>Cross-assembly optimization</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.AllowCrossAssemblyIPO" @bind:set="(bool value) => OptionsChangedAsync(_options with { AllowCrossAssemblyIPO = value })" disabled="@_busy" /></label>
                    <label><span>Verify after each pass</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.VerifyEachPass" @bind:set="(bool value) => OptionsChangedAsync(_options with { VerifyEachPass = value })" disabled="@_busy" /></label>
                    <label title="Generated IL may rely on little-endian byte order."><span>Assume little-endian platform</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.AssumeLittleEndian" @bind:set="(bool value) => OptionsChangedAsync(_options with { AssumeLittleEndian = value })" disabled="@_busy" /></label>
                    <label><span>Preserve trimming dependencies</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.PreserveTrimmingDependencies" @bind:set="(bool value) => OptionsChangedAsync(_options with { PreserveTrimmingDependencies = value })" disabled="@_busy" /></label>
                    <label title="Limit transformations to IL supported by NativeAOT."><span>NativeAOT compatibility</span><input class="switch" type="checkbox" role="switch" @bind:get="_options.NativeAotCompatibility" @bind:set="(bool value) => OptionsChangedAsync(_options with { NativeAotCompatibility = value })" disabled="@_busy" /></label>
                    <label class="settings-budget" title="Larger callers may only inline without growing."><span>Caller IL budget (bytes)</span><input type="number" min="0" max="@int.MaxValue" step="1" @bind:get="_options.MaxInlinedMethodILSize" @bind:set="(int value) => OptionsChangedAsync(_options with { MaxInlinedMethodILSize = Math.Max(0, value) })" disabled="@_busy" /></label>
                </div>
            </details>
            <button class="button secondary" @onclick="OpenPipelineAsync" disabled="@(_busy || _editor == null)" aria-haspopup="dialog">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1" /><rect x="15" y="15" width="6" height="6" rx="1" /><path d="M6 9v9h9M9 6h9v9" /></svg>
                Pipeline <span class="tab-count">@(_options.Pipeline == null ? "Default" : "Custom")</span>
            </button>
            <span class="toolbar-space"></span>
            <button class="button secondary" @onclick="ShareAsync" disabled="@(_busy || _editor == null || _sharing)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 13 4-4m-6 7-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2-2 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" transform="translate(1 2)" /></svg>
                @(_sharing ? "Creating link…" : "Share")
            </button>
            <button class="button secondary download-button" @onclick="DownloadAssemblyAsync" disabled="@(_busy || _dirty || _output?.Assembly == null)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m-4.5-4.5L12 15l4.5-4.5M5 19.5h14" /></svg>
                Download DLL
            </button>
            <button class="button primary" @onclick="CompileAsync" disabled="@(_busy || _compiler == null)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.8v14.4a1 1 0 0 0 1.52.85l11.5-7.2a1 1 0 0 0 0-1.7L8.52 3.95A1 1 0 0 0 7 4.8Z" /></svg>
                Compile & optimize <kbd>Ctrl ↵</kbd>
            </button>
        </div>

        @if (_shareError != null) {
            <div class="share-alert" role="alert"><span>@_shareError</span><button aria-label="Dismiss share message" @onclick="() => _shareError = null">×</button></div>
        }

        <div class="workspace" aria-busy="@(_busy ? "true" : "false")" @ref="_workspaceElement">
            <section class="source-panel panel" aria-label="C# source">
                <div class="panel-heading">
                    <span class="file-label"><span class="language-badge">C#</span> Code Editor</span>
                    @if (_dirty) { <span class="source-state">Modified</span> }
                </div>
                <div class="editor-host source-editor" @ref="_sourceElement"></div>
                <div class="panel-footer"><span class="status-dot"></span> Your code stays in this browser</div>
            </section>

            <div class="workspace-splitter" role="separator" tabindex="0" aria-label="Resize source and results" aria-orientation="vertical" aria-valuemin="20" aria-valuemax="65" aria-valuenow="32" @ref="_splitterElement"><span></span></div>

            <section class="output-panel panel" aria-label="Compiler output">
                <div class="view-tabs" role="tablist" aria-label="Output view">
                    <button id="passes-tab" role="tab" aria-selected="@(IsPassView ? "true" : "false")" aria-controls="output-view" class="@(IsPassView ? "active" : "")" @onclick="() => ChangeViewAsync(OutputView.Passes)" disabled="@_busy">Pass transformations <span class="tab-count">@(SelectedMethod?.Passes.Count ?? 0)</span></button>
                    <button id="il-tab" role="tab" aria-selected="@(IsILView ? "true" : "false")" aria-controls="output-view" class="@(IsILView ? "active" : "")" @onclick="() => ChangeViewAsync(OutputView.IL)" disabled="@_busy">Generated IL</button>
                    <button id="csharp-tab" role="tab" aria-selected="@(IsCSharpView ? "true" : "false")" aria-controls="output-view" class="@(IsCSharpView ? "active" : "")" @onclick="() => ChangeViewAsync(OutputView.CSharp)" disabled="@_busy">ILSpy C#</button>
                    @if (!ShowGraphs) {
                        <label class="split-toggle" title="Split view"><input class="switch" type="checkbox" role="switch" @bind="_splitView" @bind:after="RenderViewAsync" disabled="@_busy" /> <span class="split-label">Split view</span></label>
                    }
                </div>

                <div id="output-view" class="output-tabpanel" role="tabpanel" aria-labelledby="@(IsCSharpView ? "csharp-tab" : IsILView ? "il-tab" : "passes-tab")">
                    @if (!IsCSharpView) {
                        <div class="output-toolbar">
                            <div class="method-picker">
                                <label for="method">Method</label>
                                <select id="method" value="@_methodIndex" @onchange="ChangeMethodAsync" disabled="@(_busy || _output?.Methods.Count is not > 0)">
                                    @if (_output?.Methods.Count is not > 0) { <option value="-1">Compile to explore methods</option> }
                                    @if (_output != null) {
                                        @for (int i = 0; i < _output.Methods.Count; i++) {
                                            <option value="@i">@_output.Methods[i].Signature</option>
                                        }
                                    }
                                </select>
                            </div>
                            @if (SelectedMethod is { } selected) {
                                <span class="method-status @(selected.Error == null ? "" : "failed")">@selected.Status</span>
                            }
                            @if (IsPassView) {
                                <div class="segmented" role="radiogroup" aria-label="Pass view">
                                    <label><input type="radio" name="pass-display" checked="@(_passDisplay == PassDisplay.IR)" @onchange="@(() => ChangePassDisplayAsync(PassDisplay.IR))" disabled="@_busy" /><span>IR diff</span></label>
                                    <label><input type="radio" name="pass-display" checked="@(_passDisplay == PassDisplay.Graphviz)" @onchange="@(() => ChangePassDisplayAsync(PassDisplay.Graphviz))" disabled="@_busy" /><span>Graphviz CFG</span></label>
                                </div>
                            }
                        </div>
                    }

                    @if (_dirty && _output != null) {
                        <div class="notice">Source, options, or pipeline changed. Compile again to update these results.</div>
                    }
                    @if (!IsCSharpView && SelectedMethod?.Error is { } methodError) {
                        <div class="error-notice" role="alert">@methodError <span>The original IL is retained for this method.</span></div>
                    }

                    <div class="inspector @(!IsPassView ? "il-view" : "")">
                        <nav class="pass-sidebar" aria-label="Optimization passes" hidden="@(!IsPassView)">
                            <div class="pass-filter"><label><input class="switch" type="checkbox" role="switch" @bind="_changedOnly" @bind:after="FilterPassesAsync" disabled="@_busy" /> Changed only</label></div>
                            <div class="pass-list">
                                @foreach (var pass in VisiblePasses) {
                                    <button class="pass-item @(pass.Number - 1 == _passIndex ? "selected" : "")" aria-current="@(pass.Number - 1 == _passIndex ? "step" : null)" @onclick="() => SelectPassAsync(pass.Number - 1)" disabled="@_busy">
                                        <span class="pass-number">@pass.Number.ToString("00")</span>
                                        <span class="pass-name" title="@pass.Name">@pass.Name</span>
                                        @if (pass.TraceMessages > 0) {
                                            <span class="pass-trace-count" title="@($"{pass.TraceMessages} trace {(pass.TraceMessages == 1 ? "message" : "messages")}")">@pass.TraceMessages<span class="visually-hidden"> trace @(pass.TraceMessages == 1 ? "message" : "messages")</span></span>
                                        }
                                        <span class="pass-dot @(pass.Error != null ? "error" : pass.Changed ? "changed" : "")" title="@(pass.Error != null ? "Failed" : pass.Changed ? "Changed" : "Unchanged")"></span>
                                    </button>
                                }
                                @if (SelectedMethod != null && !VisiblePasses.Any()) {
                                    <p class="sidebar-empty">@(_changedOnly ? "No changed passes." : "No passes ran for this method.")</p>
                                }
                            </div>
                            <div class="pass-legend"><span class="pass-dot changed"></span> Changed <span class="pass-dot"></span> Unchanged</div>
                        </nav>

                        <div class="diff-panel" @ref="_diffPanelElement">
                            <div class="diff-heading" hidden="@ShowGraphs">
                                <span><span class="diff-minus">−</span> @(IsCSharpView ? "Original assembly" : IsILView ? "Roslyn IL" : "Before pass")</span>
                                <span><span class="diff-plus">+</span> @(IsCSharpView ? "Optimized assembly" : IsILView ? (SelectedMethod?.Error != null ? "Retained IL" : "Cilica IL") : "After pass")</span>
                            </div>
                            <div class="diff-editor-container">
                                <div class="editor-host diff-editor" @ref="_diffElement" hidden="@ShowGraphs"></div>
                                <div class="graph-grid" hidden="@(!ShowGraphs)">
                                    <section class="graph-panel">
                                        <div class="graph-heading"><span>Before pass</span><output aria-label="Before graph zoom"></output><button title="Zoom out" aria-label="Zoom out before graph" @onclick="() => ZoomGraphAsync(true, 0.8)">−</button><button title="Fit graph" aria-label="Fit before graph" @onclick="() => FitGraphAsync(true)">Fit</button><button title="Zoom in" aria-label="Zoom in before graph" @onclick="() => ZoomGraphAsync(true, 1.25)">+</button></div>
                                        <div class="graph-canvas" aria-label="Control-flow graph before pass" @ref="_beforeGraphElement"></div>
                                    </section>
                                    <section class="graph-panel">
                                        <div class="graph-heading"><span>After pass</span><output aria-label="After graph zoom"></output><button title="Zoom out" aria-label="Zoom out after graph" @onclick="() => ZoomGraphAsync(false, 0.8)">−</button><button title="Fit graph" aria-label="Fit after graph" @onclick="() => FitGraphAsync(false)">Fit</button><button title="Zoom in" aria-label="Zoom in after graph" @onclick="() => ZoomGraphAsync(false, 1.25)">+</button></div>
                                        <div class="graph-canvas" aria-label="Control-flow graph after pass" @ref="_afterGraphElement"></div>
                                    </section>
                                </div>
                                @if (_busy || OutputMissing || _viewError != null) {
                                    <div class="empty-state" role="status">
                                        @if (_busy) {
                                            <span class="spinner" aria-hidden="true"></span>
                                        } else {
                                            <span class="empty-symbol" aria-hidden="true">{ }</span>
                                        }
                                        <strong>@(_busy ? _status : _viewError != null ? "Unable to display this view" : _error != null ? "Unable to compile" : _output?.Diagnostics.Any(diagnostic => diagnostic.Severity == "Error") == true ? "Check your C# source" : SelectedMethod == null ? "Your compilation, step by step" : "No transformations to display")</strong>
                                        <span>@(_busy ? "Running locally in WebAssembly." : _viewError ?? _error ?? "Compile a snippet, choose a method, and inspect its transformation.")</span>
                                    </div>
                                }
                            </div>
                            <section class="trace-panel @(_traceOpen ? "open" : "")" aria-label="Pass trace log" hidden="@(!IsPassView)">
                                <div class="trace-splitter" role="separator" tabindex="0" aria-label="Resize trace log" aria-orientation="horizontal" aria-valuemin="15" aria-valuemax="75" aria-valuenow="32" hidden="@(!_traceOpen)" @ref="_traceSplitterElement"><span></span></div>
                                <button class="trace-heading" aria-expanded="@(_traceOpen ? "true" : "false")" aria-controls="trace-log" @onclick="ToggleTrace">
                                    <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    Trace log
                                    <span class="tab-count">@(SelectedPass?.TraceMessages ?? 0)</span>
                                </button>
                                <div id="trace-log" class="trace-log" tabindex="0" hidden="@(!_traceOpen)">
                                    @if (SelectedPass is not { } tracedPass) {
                                        <p class="trace-empty">Choose a pass to read its trace log.</p>
                                    } else if (tracedPass.Trace.Count == 0) {
                                        <p class="trace-empty">@tracedPass.Name logged no messages for this method.</p>
                                    } else {
                                        @foreach (var entry in tracedPass.Trace) {
                                            <div class="trace-entry @(entry.IsScope ? "scope" : $"level-{entry.Level.ToString().ToLowerInvariant()}")" style="--depth: @entry.Depth">@if (!entry.IsScope && entry.Level > Cilica.LogLevel.Trace) {<span class="trace-level">@entry.Level.ToString().ToUpperInvariant()</span>}@entry.Message</div>
                                        }
                                    }
                                </div>
                            </section>
                            <div class="diff-footer">
                                @if (IsCSharpView) {
                                    <span>ILSpy · decompiled C# · whole assembly</span>
                                } else if (IsILView) {
                                    <span>Managed IL · before and after the full pipeline</span>
                                } else if (SelectedPass is { } current) {
                                    <span><strong>@current.Name</strong> · @(current.Error != null ? "Failed" : current.Changed ? "Changed" : "Unchanged")</span>
                                    <span>@current.Milliseconds.ToString("0.00") ms</span>
                                } else {
                                    <span>Choose a pass to inspect its IR.</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <footer class="app-footer">
            <span class="run-summary" role="status">@RunSummary</span>
            <span>Powered by <a href="https://github.com/hez2010/CilicaLab" target="_blank" rel="noopener noreferrer">CilicaLab</a></span>
        </footer>
    </main>
</div>

<dialog class="lab-dialog pipeline-dialog" aria-labelledby="pipeline-title" @ref="_pipelineDialogElement">
    <div class="dialog-heading">
        <h2 id="pipeline-title">Optimization pipeline</h2>
        <button aria-label="Close pipeline builder" @onclick="ClosePipelineAsync"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
    </div>
    @if (_defaultPipeline != null) {
        <PipelineBuilder Value="_options.Pipeline" DefaultPipeline="_defaultPipeline" ValueChanged="PipelineChangedAsync" Disabled="_busy" />
    }
    <div class="pipeline-footer"><span>Changes apply on the next compile.</span><button class="button primary" @onclick="ClosePipelineAsync">Done</button></div>
</dialog>

<dialog class="lab-dialog share-dialog" aria-labelledby="share-title" @ref="_shareDialogElement">
    <div class="dialog-heading"><h2 id="share-title">Share snippet</h2><button aria-label="Close share dialog" @onclick="CloseShareDialogAsync">×</button></div>
    <p>Source code, compiler options, and the optimization pipeline are included in this link.</p>
    <input class="share-url" aria-label="Share link" value="@_shareUrl" readonly spellcheck="false" @ref="_shareInputElement" />
    <div class="share-actions"><span role="status">@_shareMessage</span><button class="button primary" @onclick="CopyShareLinkAsync">Copy link</button></div>
</dialog>
